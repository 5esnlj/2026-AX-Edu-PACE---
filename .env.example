# Copy to .env at the project root. The Python server loads it automatically.
# Shell environment variables take priority. Never commit .env or a real API key.
IEUM_AGENT_PROVIDER=demo
UPSTAGE_API_KEY=
SOLAR_MODEL=solar-pro2

# Optional server settings.
IEUM_DEMO_ENABLED=true
IEUM_SECURE_COOKIES=false
IEUM_DB_PATH=.data/ieum.db
# Set these in your shell to change the Node dev runner's ports:
# IEUM_API_PORT=8000
# IEUM_WEB_PORT=5173
# CHROMIUM_PATH=/usr/bin/chromium
